# Postgres (read by docker-compose.yml)
POSTGRES_DB=verydelivery_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432

# App (must match the Postgres values above)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/verydelivery_crm
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_WEBHOOK_SECRET=
# Optional (defaults: 3100 / 127.0.0.1)
# PORT=3100
# HOST=127.0.0.1
