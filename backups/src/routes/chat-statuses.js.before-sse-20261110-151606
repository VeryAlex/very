'use strict';

const { getUser } = require('../auth');

function send(res, status, data) {
  res.writeHead(status, {
    'Content-Type': 'application/json; charset=utf-8',
    'Cache-Control': 'no-store'
  });
  res.end(JSON.stringify(data));
}

async function readBody(req) {
  let body = '';
  for await (const chunk of req) {
    body += chunk;
    if (body.length > 20000) {
      throw new Error('Слишком большой запрос');
    }
  }
  return JSON.parse(body || '{}');
}

async function handleChatStatuses(req, res, db, url) {
  const route = url.pathname;

  if (!/^\/api\/chat-statuses(?:\/\d+)?$/.test(route)) {
    return false;
  }

  const user = await getUser(req, db);

  if (!user) {
    return send(res, 401, { error: 'Необходим вход' });
  }

  try {
    const match = route.match(/^\/api\/chat-statuses(?:\/(\d+))?$/);
    const statusId = match[1] ? Number(match[1]) : null;

    // Получение статусов
    if (req.method === 'GET' && !statusId) {
      if (user.role === 'admin') {
        const result = await db.query(`
          SELECT s.id, s.manager_id, s.name,
                 s.created_at, s.updated_at,
                 u.display_name AS manager_name
          FROM manager_chat_statuses s
          JOIN users u ON u.id = s.manager_id
          ORDER BY u.display_name, lower(s.name)
        `);

        return send(res, 200, { statuses: result.rows });
      }

      const result = await db.query(`
        SELECT id, manager_id, name, created_at, updated_at
        FROM manager_chat_statuses
        WHERE manager_id = $1
        ORDER BY lower(name)
      `, [user.id]);

      return send(res, 200, { statuses: result.rows });
    }

    // Изменять личные статусы могут только менеджеры
    if (user.role !== 'manager') {
      return send(res, 403, {
        error: 'Изменение статусов доступно только менеджерам'
      });
    }

    // Создание статуса
    if (req.method === 'POST' && !statusId) {
      const body = await readBody(req);
      const name = String(body.name || '').trim();

      if (!name || name.length > 60) {
        return send(res, 400, {
          error: 'Название должно содержать от 1 до 60 символов'
        });
      }

      const result = await db.query(`
        INSERT INTO manager_chat_statuses (manager_id, name)
        VALUES ($1, $2)
        ON CONFLICT (manager_id, name) DO NOTHING
        RETURNING id, manager_id, name, created_at, updated_at
      `, [user.id, name]);

      if (!result.rowCount) {
        return send(res, 409, {
          error: 'Такой статус уже существует'
        });
      }

      return send(res, 201, { status: result.rows[0] });
    }

    // Переименование своего статуса
    if (req.method === 'PATCH' && statusId) {
      const body = await readBody(req);
      const name = String(body.name || '').trim();

      if (!name || name.length > 60) {
        return send(res, 400, {
          error: 'Название должно содержать от 1 до 60 символов'
        });
      }

      const result = await db.query(`
        UPDATE manager_chat_statuses
        SET name = $1, updated_at = now()
        WHERE id = $2 AND manager_id = $3
        RETURNING id, manager_id, name, created_at, updated_at
      `, [name, statusId, user.id]);

      if (!result.rowCount) {
        return send(res, 404, {
          error: 'Статус не найден'
        });
      }

      return send(res, 200, { status: result.rows[0] });
    }

    // Удаление своего статуса
    if (req.method === 'DELETE' && statusId) {
      const result = await db.query(`
        DELETE FROM manager_chat_statuses
        WHERE id = $1 AND manager_id = $2
        RETURNING id
      `, [statusId, user.id]);

      if (!result.rowCount) {
        return send(res, 404, {
          error: 'Статус не найден'
        });
      }

      return send(res, 200, { success: true });
    }

    return send(res, 405, {
      error: 'Метод не поддерживается'
    });

  } catch (error) {
    if (error.code === '23505') {
      return send(res, 409, {
        error: 'Такой статус уже существует'
      });
    }

    if (error instanceof SyntaxError) {
      return send(res, 400, {
        error: 'Некорректный JSON'
      });
    }

    console.error('CHAT STATUSES ERROR:', error);

    return send(res, 500, {
      error: 'Ошибка работы со статусами'
    });
  }
}

module.exports = { handleChatStatuses };
