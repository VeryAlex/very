*{box-sizing:border-box}
:root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#242424;background:#f5f5f2}
body{margin:0;min-height:100vh}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
#app{min-height:100vh}
.brand{display:flex;align-items:center;gap:11px;font-size:13px;font-weight:850;letter-spacing:1.2px}
.brand-mark{display:grid;place-items:center;width:39px;height:39px;border-radius:11px;background:#ffca05;font-weight:950;color:#171717}
.login-card{width:calc(100% - 32px);max-width:420px;margin:10vh auto;background:white;padding:38px;border:1px solid #eaeae7;border-radius:20px;box-shadow:0 15px 50px #00000008}
h1{font-size:27px;letter-spacing:-.7px}
.login-card h1{margin:34px 0 7px}
.subtitle{color:#888;font-size:14px}
label{display:block;font-size:13px;font-weight:650;margin:20px 0 7px}
input,textarea,select{border:1px solid #e4e4e1;border-radius:10px;padding:12px;background:white;outline:none;width:100%}
input:focus,textarea:focus,select:focus{border-color:#d2a900}
.login-card button,.manager-form button{width:100%;margin-top:22px;background:#ffca05;border:0;border-radius:10px;padding:13px;font-weight:750}
.error{color:#c33;font-size:13px}
.success{color:#27834d;font-size:13px}
.muted{color:#999}
#dashboard{height:100vh;display:flex;flex-direction:column;min-height:550px}
.topbar{height:66px;flex:none;background:white;border-bottom:1px solid #e9e9e6;display:flex;align-items:center;justify-content:space-between;padding:0 24px}
.topbar-right{display:flex;align-items:center;gap:18px;font-size:13px}
.secondary{background:white;border:1px solid #ddd;border-radius:9px;padding:9px 15px}
.connection{font-size:12px;color:#a17d00}
.connection.online{color:#27834d}
.admin-panel{background:#fff;border-bottom:1px solid #eee;padding:10px 24px}
.admin-panel summary{cursor:pointer;font-size:13px;font-weight:700}
.manager-form{display:flex;gap:8px;margin-top:12px;max-width:900px}
.manager-form input{min-width:0}
.manager-form button{width:auto;white-space:nowrap;margin:0;padding:10px 16px}
.manager-row{display:flex;align-items:center;gap:12px;padding:8px 0;font-size:13px}
.small-button{border:1px solid #ddd;background:white;border-radius:7px;padding:5px 9px}
.messenger{flex:1;min-height:0;display:grid;grid-template-columns:370px minmax(0,1fr);margin:16px auto;width:calc(100% - 32px);max-width:1600px;background:white;border:1px solid #e8e8e5;border-radius:15px;overflow:hidden;box-shadow:0 8px 30px #00000005}
.sidebar{display:flex;flex-direction:column;min-height:0;border-right:1px solid #eee}
.sidebar-heading{display:flex;justify-content:space-between;align-items:center;padding:19px 18px 12px}
.sidebar-heading h1{font-size:21px;margin:0 0 4px}
#chat-count{font-size:12px;color:#999}
.icon-button{border:0;background:#f5f5f2;border-radius:9px;width:35px;height:35px;font-size:22px}
.search{width:calc(100% - 32px);margin:5px 16px 12px;background:#f7f7f5;border-color:#f0f0ed}
.filters{display:flex;gap:6px;padding:0 16px 12px;border-bottom:1px solid #eee}
.filter{border:0;background:transparent;border-radius:8px;padding:8px 12px;color:#777;font-size:12px}
.filter.active{background:#fff3c2;color:#5b4900;font-weight:700}
.chat-list{overflow:auto;flex:1}
.chat-item{width:100%;display:flex;text-align:left;gap:12px;padding:14px 16px;border:0;border-bottom:1px solid #f0f0ee;background:white}
.chat-item:hover{background:#fafaf7}
.chat-item.active{background:#fff9e4;border-left:3px solid #ffca05;padding-left:13px}
.avatar{flex:none;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#f1f1ed;font-weight:750}
.chat-item-body{min-width:0;flex:1}
.chat-item-top{display:flex;justify-content:space-between;gap:8px}
.chat-item-top strong{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chat-item time{font-size:10px;color:#999;flex:none}
.chat-item-product{font-size:11px;color:#777;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-item-preview{font-size:12px;color:#555;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-item-bottom{margin-top:7px}
.status{font-size:10px;border-radius:20px;padding:4px 8px}
.status.free{background:#f1f1ed;color:#777}
.status.assigned{background:#fff1bd;color:#725800}
.conversation{display:flex;min-width:0;min-height:0}
.chat-placeholder{margin:auto;text-align:center;color:#999}
.chat-placeholder h2{color:#333;font-size:19px}
.placeholder-icon{margin:auto;width:65px;height:65px;border-radius:20px;background:#ffca05;color:#222;display:grid;place-items:center;font-weight:900;font-size:23px}
.conversation-view{display:flex;flex-direction:column;flex:1;min-height:0}
.conversation-header{height:69px;flex:none;border-bottom:1px solid #eee;display:flex;align-items:center;gap:13px;padding:0 20px}
.conversation-person{display:flex;flex-direction:column;min-width:0;flex:1}
.conversation-person strong{font-size:14px}
.conversation-person span{font-size:11px;color:#999;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#assignment-control select{width:auto;max-width:190px;font-size:12px;padding:8px}
.message-list{flex:1;overflow:auto;padding:24px;display:flex;flex-direction:column;gap:12px;background:#fafaf8}
.message-row{display:flex}
.message-row.incoming{justify-content:flex-start}
.message-row.outgoing{justify-content:flex-end}
.bubble{max-width:min(72%,600px);padding:11px 14px;border-radius:13px;background:white;border:1px solid #eee;box-shadow:0 2px 5px #00000004}
.outgoing .bubble{background:#fff2c5;border-color:#f5e7b6}
.message-text{font-size:13px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}
.bubble time{display:block;text-align:right;color:#999;font-size:10px;margin-top:6px}
.message-form{display:flex;align-items:flex-end;gap:10px;padding:14px 18px;border-top:1px solid #eee;background:white}
.message-form textarea{resize:none;max-height:120px;min-height:44px;flex:1}
.message-form button{border:0;background:#ffca05;border-radius:10px;padding:13px 18px;font-size:12px;font-weight:750}
.message-form button:disabled{opacity:.5}
.message-error{margin:0;padding:0 18px 8px}
.empty{padding:30px 15px;text-align:center;color:#999;font-size:13px}
.back-button{display:none;border:0;background:#f3f3ef;border-radius:8px;padding:8px}
@media(max-width:760px){
 #dashboard{height:100dvh}
 .topbar{padding:0 12px}
 .topbar-right{gap:8px}
 #user-info{display:none}
 .messenger{width:100%;margin:0;border-radius:0;border-left:0;border-right:0;grid-template-columns:1fr}
 .conversation{display:none}
 .messenger.mobile-chat-open .sidebar{display:none}
 .messenger.mobile-chat-open .conversation{display:flex}
 .back-button{display:block}
 .manager-form{flex-direction:column}
 .manager-form button{width:100%}
 .message-list{padding:14px}
 .bubble{max-width:88%}
}


/* Непрочитанные сообщения */
.chat-item-meta {
  display: flex;
  align-items: center;
  gap: 7px;
  flex: none;
}

.chat-item .unread-name {
  font-weight: 850;
  color: #171717;
}

.unread-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 21px;
  height: 21px;
  padding: 0 6px;
  border-radius: 20px;
  background: #ffca05;
  color: #242424;
  font-size: 10px;
  font-weight: 850;
}

.chat-item .unread-preview {
  color: #242424;
  font-weight: 700;
}

/* ===== ОБНОВЛЁННЫЙ ИНТЕРФЕЙС ПЕРЕПИСКИ ===== */

.message-list {
  gap: 10px;
  padding: 22px;
  background: #f8f8f5;
}

.bubble {
  max-width: min(76%, 650px);
  padding: 12px 15px;
  border-radius: 14px;
  box-shadow: 0 1px 3px #00000006;
}

.incoming .bubble {
  border-radius: 14px 14px 14px 4px;
}

.outgoing .bubble {
  border-radius: 14px 14px 4px 14px;
}

.message-text {
  font-size: 13px;
  line-height: 1.55;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.message-form {
  align-items: flex-end;
  gap: 10px;
  padding: 13px 16px;
}

.message-form textarea {
  min-height: 44px;
  max-height: 120px;
  height: 44px;
  overflow-y: auto;
  line-height: 1.45;
  padding: 11px 13px;
  border-radius: 11px;
}

.message-form button {
  min-height: 44px;
  white-space: nowrap;
  border-radius: 10px;
  transition: opacity .15s ease;
}

.message-form button:hover:not(:disabled) {
  opacity: .85;
}

.message-form button:disabled {
  cursor: not-allowed;
}

@media(max-width:760px) {
  .message-list {
    padding: 14px;
    gap: 9px;
  }

  .bubble {
    max-width: 88%;
  }

  .message-form {
    padding: 10px;
    gap: 7px;
  }

  .message-form button {
    padding: 12px;
  }
}

/* ===== КОМПАКТНЫЕ ПУЗЫРЬКИ ===== */

.message-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  flex: 0 0 auto;
}

.message-row.incoming {
  justify-content: flex-start;
}

.message-row.outgoing {
  justify-content: flex-end;
}

.message-row .bubble {
  display: inline-block;
  flex: 0 1 auto;
  width: fit-content;
  height: auto;
  min-width: 0;
  min-height: 0;
  max-width: min(76%, 650px);
  padding: 9px 13px;
  margin: 0;
}

.message-row .message-text {
  display: block;
  min-height: 0;
  margin: 0;
  font-size: 13px;
  line-height: 1.45;
}

@media(max-width:760px) {
  .message-row .bubble {
    max-width: 88%;
  }
}

/* ===== TELEGRAM COMPACT MESSAGE BUBBLES ===== */

.message-row {
  display: flex !important;
  align-items: flex-start !important;
  flex: 0 0 auto !important;
  width: 100%;
}

.message-row.incoming {
  justify-content: flex-start !important;
}

.message-row.outgoing {
  justify-content: flex-end !important;
}

.message-row .bubble {
  display: block !important;
  width: fit-content !important;
  min-width: 0 !important;
  max-width: min(70%, 600px) !important;
  min-height: 0 !important;
  height: auto !important;
  flex: 0 1 auto !important;
  align-self: flex-start !important;

  padding: 6px 10px !important;
  margin: 0 !important;

  border-radius: 12px !important;
  box-sizing: border-box !important;
  box-shadow: none !important;
}

.message-row .message-text {
  font-size: 13px !important;
  line-height: 1.35 !important;
  margin: 0 !important;
  padding: 0 !important;
  min-height: 0 !important;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.message-row .bubble time {
  display: none !important;
}

@media(max-width:760px) {
  .message-row .bubble {
    max-width: 85% !important;
  }
}


/* =====================================
   VERY DELIVERY CRM — TELEGRAM DESIGN
   ===================================== */

.message-list {
  background: #f4f4f1 !important;
  padding: 20px 22px !important;
  gap: 7px !important;
}

/* Строки сообщений */
.message-row {
  display: flex !important;
  width: 100% !important;
  flex: 0 0 auto !important;
  align-items: flex-end !important;
  margin: 0 !important;
}

.message-row.incoming {
  justify-content: flex-start !important;
}

.message-row.outgoing {
  justify-content: flex-end !important;
}

/* Пузырьки */
.message-row .bubble {
  display: block !important;
  width: fit-content !important;
  min-width: 0 !important;
  min-height: 0 !important;
  height: auto !important;
  max-width: min(68%, 620px) !important;
  flex: 0 1 auto !important;

  padding: 8px 12px !important;
  margin: 0 !important;

  border-radius: 14px !important;
  border: 1px solid #eaeae7 !important;

  background: #ffffff !important;
  box-shadow: 0 1px 2px rgba(0,0,0,.035) !important;

  box-sizing: border-box !important;
}

/* Входящие */
.message-row.incoming .bubble {
  border-bottom-left-radius: 4px !important;
}

/* Исходящие */
.message-row.outgoing .bubble {
  background: #fff0bd !important;
  border-color: #f6e5a9 !important;
  border-bottom-right-radius: 4px !important;
}

/* Текст */
.message-row .message-text {
  display: block !important;
  font-size: 13px !important;
  line-height: 1.4 !important;
  font-weight: 400 !important;

  padding: 0 !important;
  margin: 0 !important;

  white-space: pre-wrap !important;
  overflow-wrap: anywhere !important;
  word-break: normal !important;
}

/* Время не показываем */
.message-row .bubble time {
  display: none !important;
}

/* Пространство между группами */
.message-row + .message-row {
  margin-top: 0 !important;
}

/* Поле отправки */
.message-form {
  padding: 12px 16px !important;
  background: white !important;
  gap: 10px !important;
}

.message-form textarea {
  border-radius: 12px !important;
  padding: 12px 14px !important;
  font-size: 13px !important;
}

.message-form button {
  border-radius: 11px !important;
  min-height: 44px !important;
  padding: 0 20px !important;
}

@media(max-width:760px) {
  .message-list {
    padding: 14px !important;
    gap: 6px !important;
  }

  .message-row .bubble {
    max-width: 82% !important;
  }
}


/* ===== FINAL MESSAGE ALIGNMENT ===== */

.message-list {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  justify-content: flex-start !important;
  gap: 5px !important;
  padding: 18px 22px !important;
  background: #f4f4f1 !important;
}

.message-row {
  display: flex !important;
  flex-direction: row !important;
  align-items: flex-start !important;
  justify-content: flex-start !important;
  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  flex: 0 0 auto !important;
  margin: 0 !important;
  padding: 0 !important;
}

.message-row.outgoing {
  justify-content: flex-end !important;
}

.message-row.incoming {
  justify-content: flex-start !important;
}

.message-row .bubble {
  display: block !important;
  position: relative !important;

  width: fit-content !important;
  max-width: min(65%, 620px) !important;
  min-width: 0 !important;
  min-height: 0 !important;

  height: auto !important;
  max-height: none !important;
  flex: 0 1 auto !important;
  align-self: flex-start !important;

  padding: 7px 11px !important;
  margin: 0 !important;

  box-sizing: border-box !important;
  text-align: left !important;
  vertical-align: top !important;

  border-radius: 13px !important;
  border: 1px solid #eaeae7 !important;
  background: #fff !important;
  box-shadow: 0 1px 2px rgba(0,0,0,.035) !important;
}

.message-row.incoming .bubble {
  border-bottom-left-radius: 4px !important;
}

.message-row.outgoing .bubble {
  background: #fff0bd !important;
  border-color: #f5e5a8 !important;
  border-bottom-right-radius: 4px !important;
}

.message-row .message-text {
  display: block !important;
  width: auto !important;
  height: auto !important;
  min-height: 0 !important;

  padding: 0 !important;
  margin: 0 !important;

  text-align: left !important;
  font-size: 13px !important;
  line-height: 1.4 !important;
  font-weight: 400 !important;

  white-space: pre-wrap !important;
  overflow-wrap: anywhere !important;
  word-break: normal !important;
}

.message-row .bubble time {
  display: none !important;
}

@media(max-width:760px) {
  .message-list {
    padding: 12px !important;
    gap: 5px !important;
  }

  .message-row .bubble {
    max-width: 82% !important;
  }
}



/* VD CRM — финальное оформление сообщений */

.message-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 18px 22px;
  overflow-y: auto;
  background: #f5f5f2;
}

.message-row {
  display: flex;
  width: 100%;
  margin: 0;
  padding: 0;
}

.message-row.incoming {
  justify-content: flex-start;
}

.message-row.outgoing {
  justify-content: flex-end;
}

.bubble {
  display: block;
  width: fit-content;
  max-width: min(68%, 620px);
  min-width: 0;
  box-sizing: border-box;
  padding: 8px 12px;
  margin: 0;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #eaeae6;
  box-shadow: 0 1px 2px rgba(0,0,0,.035);
}

.outgoing .bubble {
  background: #fff2c5;
  border-color: #f5e6a9;
}

.message-text {
  display: block;
  width: auto;
  margin: 0;
  padding: 0;
  text-align: left;
  font-size: 13px;
  line-height: 1.4;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: normal;
}

@media(max-width:760px) {
  .bubble {
    max-width: 88%;
  }

  .message-list {
    padding: 12px;
    gap: 5px;
  }
}


/* ===== RESPONSIVE MESSAGE INPUT ===== */

.message-form {
  align-items: flex-end !important;
}

.message-form textarea {
  box-sizing: border-box !important;
  flex: 1 1 auto !important;
  width: 100% !important;
  min-width: 0 !important;
  min-height: 44px !important;
  max-height: 120px !important;
  height: 44px;
  resize: none !important;
  overflow-x: hidden !important;
  overflow-y: hidden;
  line-height: 1.45 !important;
  padding: 11px 13px !important;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}

@media (max-width: 760px) {
  .message-form {
    align-items: flex-end !important;
    gap: 7px !important;
    padding: 9px 10px !important;
  }

  .message-form textarea {
    min-height: 44px !important;
    max-height: 104px !important;
    font-size: 16px !important;
    touch-action: pan-y;
  }

  .message-form button {
    flex: 0 0 auto !important;
    min-height: 44px !important;
    padding: 0 12px !important;
  }
}


/* ===== CONVERSATION HEADER REDESIGN ===== */

.conversation-header {
  min-width: 0;
  gap: 13px;
  padding: 0 20px;
  background: #fff;
}

.conversation-avatar {
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #fff1bd;
  color: #665000;
  font-size: 16px;
  font-weight: 800;
  text-transform: uppercase;
}

.conversation-person {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.conversation-person strong {
  font-size: 15px;
  font-weight: 750;
  color: #242424;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-person a {
  display: block;
  max-width: 100%;
  font-size: 11px;
  line-height: 1.4;
  color: #888;
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-person a:hover {
  color: #947300;
  text-decoration: underline;
}

#assignment-control {
  flex: 0 0 auto;
  min-width: 0;
}

#assignment-control select {
  max-width: 175px;
}

@media (max-width: 760px) {
  .conversation-header {
    gap: 9px;
    padding: 0 10px;
  }

  .conversation-avatar {
    width: 37px;
    height: 37px;
    flex-basis: 37px;
    font-size: 14px;
  }

  .conversation-person strong {
    font-size: 14px;
  }

  .conversation-person a {
    font-size: 10px;
  }

  #assignment-control select {
    max-width: 112px;
    font-size: 11px;
    padding: 7px 5px;
  }
}


/* ===== ФОТО ОБЪЯВЛЕНИЯ В СПИСКЕ ЧАТОВ ===== */

.chat-item-avatar {
  position: relative;
  flex: 0 0 48px;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  overflow: hidden;
  display: grid;
  place-items: center;
  background: #f1f1ed;
  color: #222;
  font-size: 15px;
  font-weight: 800;
}

.chat-item-avatar img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  border-radius: inherit;
}

.chat-item {
  align-items: flex-start;
}

.chat-item-body {
  min-width: 0;
  flex: 1;
}

@media(max-width:760px) {
  .chat-item-avatar {
    flex-basis: 44px;
    width: 44px;
    height: 44px;
    border-radius: 10px;
  }
}


/* ===== ITEM PRICE IN HEADER ===== */

.active-price {
  display: block;
  margin-top: 3px;
  color: #27834d;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.active-price[hidden] {
  display: none !important;
}

@media(max-width:760px) {
  .active-price {
    font-size: 12px;
    margin-top: 2px;
  }
}


/* ===== INTERNAL NOTES VD ===== */

.notes-panel {
  flex: 0 0 auto;
  max-height: 245px;
  display: flex;
  flex-direction: column;
  border-top: 1px solid #eaeae6;
  background: #fff;
  padding: 12px 16px 8px;
  min-height: 0;
}

.notes-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.notes-heading > div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.notes-heading strong {
  font-size: 12px;
  color: #333;
}

.notes-heading span {
  font-size: 10px;
  color: #999;
}

.notes-count {
  display: grid;
  place-items: center;
  min-width: 23px;
  height: 23px;
  border-radius: 20px;
  background: #fff3c2;
  color: #725800 !important;
  font-weight: 800;
}

.notes-list {
  overflow-y: auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.note-card {
  background: #faf9f5;
  border: 1px solid #eeece4;
  border-radius: 9px;
  padding: 8px 11px;
}

.note-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.note-top strong {
  font-size: 11px;
  color: #333;
}

.note-top time {
  font-size: 10px;
  color: #999;
}

.note-text {
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.45;
  color: #444;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.note-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 5px;
}

.note-actions button {
  border: 0;
  padding: 2px 0;
  background: transparent;
  color: #777;
  font-size: 10px;
  cursor: pointer;
}

.note-actions button:hover {
  color: #222;
}

.note-actions button:last-child:hover {
  color: #c43d32;
}

.notes-empty {
  color: #999;
  text-align: center;
  font-size: 11px;
  padding: 10px;
}

.notes-form {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  margin-top: 8px;
}

.notes-form textarea {
  flex: 1;
  min-width: 0;
  min-height: 36px;
  max-height: 65px;
  resize: vertical;
  border: 1px solid #e8e6df;
  border-radius: 9px;
  padding: 8px 10px;
  font: inherit;
  font-size: 11px;
  line-height: 1.4;
}

.notes-form button {
  flex: none;
  border: 0;
  border-radius: 9px;
  background: #ffca05;
  color: #222;
  padding: 10px 13px;
  font-size: 11px;
  font-weight: 750;
  cursor: pointer;
}

.notes-form button:disabled {
  opacity: .5;
}

.notes-error {
  margin: 3px 0 0;
  color: #c43d32;
  font-size: 10px;
}

@media(max-width:760px) {
  .notes-panel {
    max-height: 225px;
    padding: 9px 10px 6px;
  }

  .notes-form textarea {
    min-height: 36px;
    max-height: 55px;
  }

  .notes-form button {
    padding: 10px;
  }
}

/* ===== END INTERNAL NOTES VD ===== */


/* ===== NOTES TOP POSITION ===== */

.notes-panel {
  order: 0;
  flex: 0 0 auto;
  max-height: 175px;
  padding: 9px 16px;
  border-top: 0;
  border-bottom: 1px solid #eaeae6;
  overflow: hidden;
}

.notes-heading {
  margin-bottom: 6px;
}

.notes-list {
  max-height: 78px;
  overflow-y: auto;
}

.notes-form {
  margin-top: 6px;
}

.notes-form textarea {
  min-height: 34px;
  max-height: 42px;
}

@media(max-width:760px) {
  .notes-panel {
    max-height: 155px;
    padding: 7px 10px;
  }

  .notes-list {
    max-height: 58px;
  }
}

/* ===== END NOTES TOP POSITION ===== */



/* ===== VD: МЕНЮ ДЕЙСТВИЙ С СООБЩЕНИЯМИ ===== */

.message-row .bubble {
  overflow: visible !important;
}

.message-menu {
  position: absolute;
  z-index: 20;
  top: 2px;
  right: -31px;
}

.message-row.outgoing .message-menu {
  right: auto;
  left: -31px;
}

.message-menu-toggle {
  width: 25px;
  height: 27px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e7e7e2;
  border-radius: 8px;
  background: #fff;
  color: #666;
  font-size: 19px;
  line-height: 1;
  cursor: pointer;
  opacity: 0;
  transition: opacity .15s ease, background .15s ease;
}

.message-row:hover .message-menu-toggle,
.message-menu-toggle:focus,
.message-menu-toggle:focus-visible {
  opacity: 1;
}

.message-menu-toggle:hover {
  background: #f4f4f0;
}

.message-menu-popup {
  position: absolute;
  top: 30px;
  right: 0;
  min-width: 145px;
  padding: 5px;
  border: 1px solid #e9e9e5;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 7px 24px rgba(0,0,0,.13);
  z-index: 30;
}

.message-row.outgoing .message-menu-popup {
  right: auto;
  left: 0;
}

.message-menu-popup[hidden] {
  display: none !important;
}

.message-menu-popup button {
  display: block;
  width: 100%;
  padding: 9px 11px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #262626;
  text-align: left;
  font-size: 12px;
  cursor: pointer;
}

.message-menu-popup button:hover {
  background: #f5f5f1;
}

.message-menu-popup .message-delete-action {
  color: #c0392b;
}

.message-menu-popup button:disabled {
  opacity: .5;
  cursor: wait;
}

@media (max-width: 760px) {
  .message-menu-toggle {
    opacity: .75;
    width: 27px;
    height: 29px;
  }

  .message-menu {
    right: -30px;
  }

  .message-row.outgoing .message-menu {
    left: -30px;
  }
}


/* ===== VD REPLY PREVIEW ===== */

.reply-preview {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 17px;
  background: #fffaf0;
  border-top: 1px solid #f1e5c4;
  border-left: 3px solid #e8b923;
}

.reply-preview[hidden] {
  display: none !important;
}

.reply-preview-content {
  flex: 1;
  min-width: 0;
}

.reply-preview-label {
  display: block;
  color: #947300;
  font-size: 10px;
  font-weight: 750;
  margin-bottom: 3px;
}

.reply-preview-text {
  color: #555;
  font-size: 12px;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

#reply-preview-cancel {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #777;
  font-size: 22px;
  cursor: pointer;
}

#reply-preview-cancel:hover {
  background: #f0eadc;
}

@media(max-width:760px) {
  .reply-preview {
    padding: 8px 11px;
  }
}

/* ===== END VD REPLY PREVIEW ===== */

/* ===== FIX: MESSAGE MENU POSITION ===== */

/* Входящие сообщения — меню открывается вправо */
.message-row.incoming .message-menu-popup {
  left: 30px !important;
  right: auto !important;
}

/* Исходящие сообщения — меню остаётся со стороны пузырька */
.message-row.outgoing .message-menu-popup {
  left: 0 !important;
  right: auto !important;
}

/* ===== END FIX ===== */


/* ===== COMPOSER TOOLS + QUICK REPLIES ===== */

.message-form {
  position: relative !important;
  min-width: 0;
}

.composer-tools {
  position: relative;
  flex: 0 0 42px;
  align-self: flex-end;
}

.composer-plus {
  width: 42px;
  height: 44px;
  border: 1px solid #e9e9e4;
  border-radius: 10px;
  background: #f7f7f3;
  color: #333;
  font-size: 27px;
  line-height: 1;
  cursor: pointer;
}

.composer-plus:hover {
  background: #fff0bd;
}

.composer-menu {
  position: absolute;
  z-index: 100;
  bottom: calc(100% + 9px);
  left: 0;
  width: 190px;
  padding: 6px;
  background: white;
  border: 1px solid #e8e8e3;
  border-radius: 12px;
  box-shadow: 0 8px 28px rgba(0,0,0,.13);
}

.composer-menu[hidden],
.quick-replies-panel[hidden] {
  display: none !important;
}

.composer-menu button {
  display: block;
  width: 100%;
  padding: 11px;
  border: 0;
  border-radius: 8px;
  background: white;
  text-align: left;
  font-size: 13px;
  cursor: pointer;
}

.composer-menu button:hover {
  background: #fff5d4;
}

.quick-replies-panel {
  position: absolute;
  z-index: 90;
  left: 18px;
  bottom: calc(100% + 9px);
  width: min(420px, calc(100% - 36px));
  max-height: 390px;
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 13px;
  background: #fff;
  border: 1px solid #e8e8e3;
  border-radius: 13px;
  box-shadow: 0 8px 30px rgba(0,0,0,.14);
}

.quick-replies-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
}

.quick-replies-heading button {
  border: 0;
  border-radius: 7px;
  background: #ffca05;
  padding: 7px 10px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

#quick-reply-search {
  width: 100%;
  min-width: 0;
  padding: 9px 10px;
  border: 1px solid #e8e8e3;
  border-radius: 8px;
  font-size: 13px;
}

#quick-replies-list {
  overflow-y: auto;
  min-height: 0;
}

.quick-reply-item {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 8px 2px;
  border-bottom: 1px solid #f0f0ec;
}

.quick-reply-use {
  flex: 1;
  min-width: 0;
  border: 0;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.quick-reply-use strong,
.quick-reply-use span {
  display: block;
}

.quick-reply-use strong {
  font-size: 12px;
  margin-bottom: 4px;
}

.quick-reply-use span {
  color: #858585;
  font-size: 11px;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-reply-actions {
  display: flex;
  gap: 3px;
}

.quick-reply-actions button {
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 7px;
  background: #f5f5f1;
  cursor: pointer;
  font-size: 16px;
}

.quick-reply-actions button:hover {
  background: #fff0bd;
}

.quick-replies-empty {
  padding: 20px 5px;
  text-align: center;
  color: #999;
  font-size: 12px;
}

.quick-reply-dialog {
  width: min(460px, calc(100% - 28px));
  padding: 0;
  border: 0;
  border-radius: 15px;
  box-shadow: 0 12px 45px rgba(0,0,0,.2);
}

.quick-reply-dialog::backdrop {
  background: rgba(0,0,0,.35);
}

#quick-reply-editor-form {
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 20px;
}

#quick-reply-editor-form h3 {
  margin: 0 0 5px;
  font-size: 17px;
}

#quick-reply-editor-form label {
  font-size: 12px;
  font-weight: 700;
}

#quick-reply-editor-form input,
#quick-reply-editor-form textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 10px;
  border: 1px solid #e5e5df;
  border-radius: 8px;
  font: inherit;
  font-size: 13px;
}

#quick-reply-editor-form textarea {
  resize: vertical;
}

.quick-reply-dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 5px;
}

.quick-reply-dialog-actions button {
  border: 0;
  border-radius: 8px;
  padding: 10px 14px;
  cursor: pointer;
  font-weight: 700;
}

.quick-reply-dialog-actions button[type="submit"] {
  background: #ffca05;
}

#quick-reply-error {
  margin: 0;
  color: #c0392b;
  font-size: 12px;
}

@media(max-width:760px) {
  .composer-tools {
    flex-basis: 37px;
  }

  .composer-plus {
    width: 37px;
    height: 44px;
  }

  .quick-replies-panel {
    left: 8px;
    width: calc(100% - 16px);
  }

  .quick-reply-dialog {
    max-height: 85dvh;
    overflow-y: auto;
  }
}

/* ===== END COMPOSER TOOLS ===== */


/* ===== VD MEDIA MESSAGES ===== */
.crm-message-image {
  display: block;
  max-width: min(100%, 420px);
  max-height: 420px;
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 10px;
  cursor: zoom-in;
  margin-top: 5px;
}

.crm-voice {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 220px;
  max-width: 320px;
  padding: 8px;
}

.crm-voice audio {
  width: 100%;
  max-width: 290px;
}

.crm-message-link {
  color: #1769aa;
  text-decoration: underline;
  overflow-wrap: anywhere;
}

.crm-media-placeholder {
  padding: 8px;
  color: #777;
}
/* ===== END VD MEDIA MESSAGES ===== */

/* ===== CRM MESSAGE STYLE FIX ===== */

.message-row {
  display: flex;
  width: 100%;
  margin: 8px 0;
  box-sizing: border-box;
}

.message-row.outgoing {
  justify-content: flex-end;
}

.message-row.incoming {
  justify-content: flex-start;
}

.message-row .bubble {
  width: fit-content !important;
  max-width: min(560px, 78%) !important;
  min-width: 0;
  box-sizing: border-box;
  padding: 10px 12px;
  border-radius: 16px;
}

.message-row .message-text {
  max-width: 100%;
  min-width: 0;
  overflow-wrap: anywhere;
}

.message-row .crm-message-image {
  display: block !important;
  width: auto !important;
  height: auto !important;
  max-width: min(100%, 480px) !important;
  max-height: 360px !important;
  object-fit: contain;
  border-radius: 12px;
  margin: 5px 0;
}

.message-row .crm-voice {
  min-width: 220px;
  max-width: 300px;
}

.message-row .crm-voice audio {
  width: 100%;
  max-width: 280px;
}

.message-row .crm-message-link {
  display: inline-block;
  max-width: 100%;
  overflow-wrap: anywhere;
  line-height: 1.5;
}

/* ===== END CRM MESSAGE STYLE FIX ===== */



/* ===== TELEGRAM STYLE PHOTO VIEWER ===== */
.crm-message-image {
  cursor: zoom-in !important;
}

.crm-photo-viewer {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: rgba(0, 0, 0, .88);
  align-items: center;
  justify-content: center;
  padding: 55px 24px;
  box-sizing: border-box;
  cursor: zoom-out;
}

.crm-photo-viewer.open {
  display: flex;
}

.crm-photo-full {
  display: block;
  max-width: 95vw;
  max-height: 90vh;
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 8px;
  cursor: default;
  box-shadow: 0 10px 50px rgba(0,0,0,.35);
}

.crm-photo-close {
  position: absolute;
  top: 18px;
  right: 24px;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 50%;
  background: rgba(255,255,255,.18);
  color: white;
  font-size: 32px;
  cursor: pointer;
}

body.crm-photo-open {
  overflow: hidden;
}

@media(max-width:760px) {
  .crm-photo-viewer {
    padding: 45px 10px;
  }

  .crm-photo-full {
    max-width: 100%;
    max-height: 88vh;
  }

  .crm-photo-close {
    top: 8px;
    right: 12px;
  }
}
/* ===== END TELEGRAM STYLE PHOTO VIEWER ===== */


/* ===== VD CLAIM CHAT IN COMPOSER ===== */
.message-form.claim-mode {
  display: flex !important;
  align-items: stretch !important;
  justify-content: center !important;
  padding: 12px 18px !important;
  background: #fff !important;
  border-top: 1px solid #eee;
  min-height: 76px;
}

.message-form.claim-mode > :not(#claim-chat-button) {
  display: none !important;
}

.message-form #claim-chat-button {
  width: 100%;
  min-height: 50px;
  border: 0;
  border-radius: 12px;
  background: #ffca05;
  color: #171717;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
}

.message-form #claim-chat-button:hover:not(:disabled) {
  background: #f4bd00;
}

.message-form #claim-chat-button:disabled {
  opacity: .65;
  cursor: wait;
}

.message-form #claim-chat-button[hidden] {
  display: none !important;
}
/* ===== END VD CLAIM CHAT IN COMPOSER ===== */


/* ===== VERY DELIVERY BRAND LOGO ===== */
.brand-logo {
  display: block;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  object-fit: contain;
  border-radius: 10px;
}

@media(max-width:760px) {
  .brand-logo {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
  }
}
/* ===== END BRAND LOGO ===== */

/* ===== VD TOPBAR ALIGNMENT ===== */
@media (min-width: 761px) {
  .topbar {
    padding-left: max(16px, calc((100vw - 1600px) / 2));
    padding-right: max(16px, calc((100vw - 1600px) / 2));
  }
}
/* ===== END VD TOPBAR ALIGNMENT ===== */

/* =========================================
   VERY DELIVERY CRM — MOBILE FINAL
   ========================================= */

@media (max-width: 760px) {

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  #app {
    height: 100%;
    min-height: 0;
  }

  #dashboard {
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }

  /* Верхняя панель */

  .topbar {
    height: 56px;
    min-height: 56px;
    padding: 0 12px;
    gap: 8px;
  }

  .brand {
    gap: 8px;
    font-size: 10px;
    letter-spacing: .7px;
  }

  .brand-logo {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
  }

  .topbar-right {
    gap: 9px;
    font-size: 11px;
  }

  .connection {
    font-size: 10px;
    white-space: nowrap;
  }

  #logout {
    padding: 8px 10px;
    font-size: 11px;
  }

  /* Рабочая область */

  .messenger {
    flex: 1;
    width: 100%;
    min-height: 0;
    height: auto;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    grid-template-columns: minmax(0, 1fr);
  }

  .sidebar,
  .conversation {
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  /* Список чатов */

  .sidebar-heading {
    padding: 14px 14px 10px;
  }

  .sidebar-heading h1 {
    font-size: 20px;
  }

  .search {
    width: calc(100% - 24px);
    margin: 4px 12px 10px;
    min-height: 44px;
    font-size: 16px;
  }

  .filters {
    gap: 5px;
    padding: 0 12px 10px;
    overflow-x: auto;
    flex-wrap: nowrap;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: 0 0 auto;
    min-height: 38px;
    padding: 8px 13px;
    font-size: 12px;
  }

  .chat-list {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .chat-item {
    min-height: 76px;
    padding: 12px;
    gap: 10px;
  }

  .chat-item.active {
    padding-left: 9px;
  }

  .avatar {
    width: 40px;
    height: 40px;
  }

  .chat-item-top strong {
    font-size: 13px;
  }

  .chat-item-preview {
    font-size: 12px;
  }

  /* Окно переписки */

  .conversation {
    display: none;
    overflow: hidden;
  }

  .messenger.mobile-chat-open .sidebar {
    display: none;
  }

  .messenger.mobile-chat-open .conversation {
    display: flex;
  }

  .conversation-view {
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .conversation-header {
    height: 62px;
    min-height: 62px;
    padding: 0 10px;
    gap: 9px;
  }

  .back-button {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    font-size: 20px;
  }

  .conversation-avatar {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
  }

  .conversation-person {
    min-width: 0;
  }

  .conversation-person strong {
    font-size: 13px;
  }

  .conversation-person a {
    font-size: 10px;
  }

  #assignment-control {
    flex: 0 0 auto;
    max-width: 115px;
  }

  #assignment-control select {
    max-width: 115px;
    padding: 7px 5px;
    font-size: 10px;
  }

  #assignment-control .status {
    font-size: 9px;
    padding: 5px 7px;
  }

  /* Внутренние заметки */

  .notes-panel {
    flex: 0 0 auto;
    max-height: 120px;
    padding: 7px 10px;
    overflow: hidden;
  }

  .notes-heading {
    margin-bottom: 5px;
  }

  .notes-heading strong {
    font-size: 11px;
  }

  .notes-heading span {
    font-size: 9px;
  }

  .notes-list {
    max-height: 38px;
    overflow-y: auto;
  }

  .notes-form {
    margin-top: 5px;
    gap: 6px;
  }

  .notes-form textarea {
    min-height: 32px;
    max-height: 38px;
    padding: 7px;
    font-size: 14px;
  }

  .notes-form button {
    min-height: 34px;
    padding: 7px 10px;
    font-size: 11px;
  }

  /* Сообщения */

  .message-list {
    flex: 1 1 0;
    min-height: 0;
    padding: 12px 10px !important;
    gap: 7px !important;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .message-row .bubble {
    max-width: 86% !important;
    padding: 9px 11px !important;
    border-radius: 13px;
  }

  .message-row .message-text {
    font-size: 14px;
    line-height: 1.45;
  }

  .message-row .crm-message-image {
    max-width: 100% !important;
    max-height: 280px !important;
  }

  .message-row .crm-voice {
    min-width: 0;
    max-width: 240px;
  }

  /* Действия с сообщениями — сенсорное управление */

  .message-menu-toggle {
    opacity: 1;
    width: 28px;
    height: 30px;
    touch-action: manipulation;
  }

  /* Ответ на сообщение */

  .reply-preview {
    padding: 7px 10px;
  }

  /* Поле ввода */

  .message-form {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    padding: 8px 9px
      calc(8px + env(safe-area-inset-bottom)) !important;
    background: #fff;
    border-top: 1px solid #eee;
  }

  .message-form textarea {
    min-width: 0;
    min-height: 44px !important;
    max-height: 100px !important;
    height: 44px;
    padding: 11px 10px !important;
    font-size: 16px !important;
    border-radius: 12px;
  }

  .composer-tools {
    flex: 0 0 38px;
  }

  .composer-plus {
    width: 38px;
    height: 44px;
  }

  .message-form #send-button {
    min-height: 44px !important;
    padding: 0 12px !important;
    font-size: 11px;
  }

  .message-form.claim-mode {
    min-height: 68px;
    padding: 9px 10px
      calc(9px + env(safe-area-inset-bottom)) !important;
  }

  .message-form #claim-chat-button {
    min-height: 48px;
  }

  .message-error {
    padding: 3px 10px 5px;
  }

  /* Диалог быстрых ответов */

  .quick-reply-dialog {
    width: calc(100% - 24px);
    max-height: 85dvh;
    overflow-y: auto;
  }

  .quick-reply-dialog input,
  .quick-reply-dialog textarea {
    font-size: 16px;
  }

  /* Удобство касаний */

  button,
  .chat-item {
    touch-action: manipulation;
  }
}

/* =========================================
   END MOBILE FINAL
   ========================================= */


/* =========================================
   VERY DELIVERY CRM — FINAL UI POLISH
   ========================================= */

/* Верхняя панель */
.connection,
#global-unread-count {
  display: none !important;
}

.topbar-right {
  gap: 14px;
}

#logout {
  background: #f5f5f1;
  color: #222;
  border: 1px solid #e8e8e2;
  border-radius: 10px;
  padding: 10px 18px;
  font-size: 12px;
  font-weight: 750;
  transition: background .15s, border-color .15s;
}

#logout:hover {
  background: #fff1bd;
  border-color: #edc94a;
}

/* Убираем ненужную информацию над списком */
.sidebar-heading h1,
#chat-count,
#refresh-chats {
  display: none !important;
}

.sidebar-heading {
  min-height: 8px;
  padding: 7px 14px 3px;
}

/* Имена клиентов всегда чёрные */
.chat-item-top strong,
.chat-item .unread-name {
  color: #202020 !important;
  text-decoration: none !important;
}

.chat-item {
  color: #222;
  text-decoration: none;
}

/* Кнопка назад */
.back-button {
  border: 1px solid #e8e8e2 !important;
  background: #f5f5f1 !important;
  color: #222 !important;
  border-radius: 10px !important;
  width: 39px;
  height: 39px;
  padding: 0 !important;
  font-size: 20px;
  font-weight: 700;
  cursor: pointer;
  transition: background .15s;
}

.back-button:hover {
  background: #fff1bd !important;
}

/* Компактные внутренние заметки */
.notes-panel {
  flex: 0 0 auto !important;
  max-height: 125px !important;
  padding: 7px 13px !important;
  overflow: hidden !important;
  background: #fff !important;
  border-bottom: 1px solid #eeeeea !important;
}

.notes-heading {
  margin-bottom: 4px !important;
}

.notes-heading strong {
  font-size: 11px !important;
}

.notes-heading span {
  font-size: 9px !important;
}

.notes-list {
  max-height: 43px !important;
  overflow-y: auto !important;
}

.notes-form {
  margin-top: 4px !important;
  gap: 7px !important;
}

.notes-form textarea {
  min-height: 32px !important;
  max-height: 36px !important;
  padding: 7px 10px !important;
  font-size: 12px !important;
}

.notes-form button {
  padding: 7px 12px !important;
  font-size: 11px !important;
}

/* Telegram-подобное оформление переписки */
.message-list {
  background: #f2f3f0 !important;
  padding: 20px 24px !important;
  gap: 8px !important;
}

.message-row {
  width: 100% !important;
  margin: 0 !important;
  display: flex !important;
  align-items: flex-end !important;
}

.message-row.incoming {
  justify-content: flex-start !important;
}

.message-row.outgoing {
  justify-content: flex-end !important;
}

.message-row .bubble {
  width: fit-content !important;
  max-width: min(72%, 580px) !important;
  min-width: 0 !important;
  padding: 9px 13px !important;
  border-radius: 15px !important;
  box-shadow: 0 1px 2px rgba(0,0,0,.06) !important;
  box-sizing: border-box !important;
  border: 1px solid transparent !important;
}

.message-row.incoming .bubble {
  background: #fff !important;
  border-color: #eaeae6 !important;
  border-radius: 15px 15px 15px 4px !important;
}

.message-row.outgoing .bubble {
  background: #fff0b8 !important;
  border-color: #f4e5a8 !important;
  border-radius: 15px 15px 4px 15px !important;
}

.message-row .message-text {
  color: #242424 !important;
  font-size: 13px !important;
  line-height: 1.5 !important;
  overflow-wrap: anywhere !important;
  white-space: pre-wrap !important;
}

/* Медиа внутри сообщений */
.message-row .crm-message-image {
  border-radius: 11px !important;
}

.message-row .crm-voice {
  padding: 5px !important;
}

/* Ошибки не должны раздувать область переписки */
.message-error {
  font-size: 12px;
}

/* Мобильная версия */
@media(max-width:760px) {

  .topbar {
    height: 58px;
    min-height: 58px;
    padding: 0 12px !important;
  }

  .topbar .brand {
    gap: 8px;
    font-size: 11px;
  }

  .topbar .brand-logo {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
  }

  #logout {
    padding: 9px 13px;
    font-size: 11px;
    border-radius: 9px;
  }

  .sidebar-heading {
    padding: 4px 12px 2px;
  }

  .back-button {
    display: grid !important;
    place-items: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
  }

  .conversation-header {
    gap: 8px;
  }

  .notes-panel {
    max-height: 105px !important;
    padding: 5px 9px !important;
  }

  .notes-list {
    max-height: 30px !important;
  }

  .notes-heading {
    margin-bottom: 3px !important;
  }

  .notes-form {
    margin-top: 3px !important;
  }

  .notes-form textarea {
    min-height: 29px !important;
    max-height: 32px !important;
  }

  .message-list {
    padding: 12px 10px !important;
    gap: 7px !important;
  }

  .message-row .bubble {
    max-width: 86% !important;
    padding: 9px 11px !important;
  }

  .message-row .message-text {
    font-size: 14px !important;
    line-height: 1.45 !important;
  }
}

/* ===== END FINAL UI POLISH ===== */

/* VD MOBILE — COMPACT NOTES */
@media (max-width:760px) {
  .notes-panel {
    box-sizing: border-box !important;
    height: auto !important;
    max-height: 88px !important;
    min-height: 0 !important;
    padding: 5px 9px !important;
    gap: 0 !important;
  }

  .notes-heading {
    margin: 0 0 3px !important;
  }

  .notes-heading > div {
    gap: 0 !important;
  }

  .notes-heading > div span {
    display: none !important;
  }

  .notes-list {
    display: none !important;
  }

  .notes-form {
    margin: 0 !important;
    align-items: center !important;
  }

  .notes-form textarea {
    height: 34px !important;
    min-height: 34px !important;
    max-height: 34px !important;
    padding: 6px 9px !important;
  }

  .notes-form button {
    height: 34px !important;
    min-height: 34px !important;
  }

  .notes-error {
    display: none;
  }

  /* Действия сообщений */
  .message-menu-toggle {
    width: 25px !important;
    height: 25px !important;
    min-width: 25px !important;
    padding: 0 !important;
    border: 1px solid #e9e9e5 !important;
    border-radius: 50% !important;
    background: rgba(255,255,255,.85) !important;
    opacity: .65 !important;
    font-size: 13px !important;
  }

  .message-list {
    gap: 9px !important;
    padding: 12px 10px !important;
  }

  .message-row .bubble {
    max-width: 84% !important;
    padding: 10px 12px !important;
  }
}

/* =========================================
   VD — SAFARI MOBILE LAYOUT STABILITY
   ========================================= */

@media (max-width: 760px) {

  html,
  body {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  #app {
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  #dashboard {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }

  .topbar {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 0 0 58px;
    width: 100%;
    height: 58px;
    min-height: 58px;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top);
  }

  .messenger {
    display: grid;
    flex: 1 1 0;
    width: 100%;
    height: auto;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    grid-template-columns: minmax(0, 1fr);
  }

  .sidebar,
  .conversation {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
  }

  .chat-list {
    flex: 1 1 0;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .conversation {
    display: none;
    flex-direction: column;
  }

  .messenger.mobile-chat-open .sidebar {
    display: none;
  }

  .messenger.mobile-chat-open .conversation {
    display: flex;
  }

  .conversation-view {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .message-list {
    flex: 1 1 0;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .message-form {
    flex: 0 0 auto;
    padding-bottom: calc(8px + env(safe-area-inset-bottom)) !important;
  }
}

/* ===== END SAFARI MOBILE LAYOUT STABILITY ===== */



/* ===== VD INCOMING NOTIFICATION BANNERS ===== */

#vd-notifications {
  position: fixed;
  z-index: 10000;
  top: 16px;
  right: 18px;
  width: min(360px, calc(100vw - 32px));
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.vd-notification {
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
  padding: 15px 17px;
  text-align: left;
  color: #222;
  background: #fff;
  border: 1px solid #e9e5d8;
  border-left: 5px solid #ffca05;
  border-radius: 13px;
  box-shadow: 0 8px 28px #00000020;
  cursor: pointer;
  pointer-events: auto;
  animation: vd-notification-in .22s ease-out;
}

.vd-notification-title {
  font-size: 14px;
  font-weight: 800;
}

.vd-notification-message {
  font-size: 13px;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.vd-notification-hint {
  color: #888;
  font-size: 11px;
}

.vd-notification-hide {
  opacity: 0;
  transform: translateX(20px);
  transition: opacity .2s, transform .2s;
}

@keyframes vd-notification-in {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 760px) {
  #vd-notifications {
    top: calc(10px + env(safe-area-inset-top));
    left: 12px;
    right: 12px;
    width: auto;
  }

  .vd-notification {
    padding: 13px 15px;
  }
}

/* ===== END VD INCOMING NOTIFICATION BANNERS ===== */


/* ===== VD WEB PUSH CONTROLS ===== */

#push-status {
  color: #777;
  font-size: 11px;
  white-space: nowrap;
}

.push-button {
  white-space: nowrap;
  padding: 9px 12px;
  font-size: 12px;
}

.push-button:disabled {
  opacity: .55;
  cursor: not-allowed;
}

@media (max-width: 760px) {
  .topbar-right {
    gap: 6px !important;
  }

  #push-status,
  #push-test,
  .push-label {
    display: none !important;
  }

  #push-toggle {
    min-width: 36px;
    width: 36px;
    height: 36px;
    padding: 0;
    display: grid;
    place-items: center;
    font-size: 16px;
  }
}

/* ===== END VD WEB PUSH CONTROLS ===== */

/* ===== VD PHOTO DRAG AND DROP ===== */

.conversation-view {
  position: relative;
}

.photo-drop-overlay {
  display: none;
  position: absolute;
  inset: 8px;
  z-index: 100;
  align-items: center;
  justify-content: center;
  padding: 24px;
  border: 3px dashed #e5b700;
  border-radius: 14px;
  background: rgba(255, 247, 196, 0.94);
  color: #252525;
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  pointer-events: none;
}

.conversation-view.photo-drag-active .photo-drop-overlay {
  display: flex;
}

@media (max-width: 768px) {
  .photo-drop-overlay {
    display: none !important;
  }
}

/* ===== END VD PHOTO DRAG AND DROP ===== */


/* ===== VD NOTES DRAWER V2 ===== */

.conversation-view {
  position: relative;
  min-height: 0;
}

.notes-toggle {
  flex: 0 0 auto;
  border: 1px solid #e6e2d7;
  border-radius: 9px;
  background: #fff;
  color: #292929;
  padding: 8px 11px;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
  white-space: nowrap;
}

.notes-toggle:hover,
.notes-toggle[aria-expanded="true"] {
  background: #fff3c2;
  border-color: #f1cb49;
}

#notes-toggle-count {
  display: inline-grid;
  place-items: center;
  min-width: 19px;
  height: 19px;
  margin-left: 3px;
  padding: 0 4px;
  border-radius: 20px;
  background: #ffca05;
  color: #222;
  font-size: 11px;
  font-weight: 800;
}

#conversation-view #notes-panel {
  display: none !important;
  position: absolute !important;
  top: 0;
  right: 0;
  bottom: 0;
  left: auto;
  z-index: 80;
  box-sizing: border-box;
  width: min(380px, 100%);
  height: 100% !important;
  max-height: none !important;
  min-height: 0 !important;
  padding: 18px !important;
  overflow: hidden !important;
  background: #fff !important;
  border: 0 !important;
  border-left: 1px solid #eaeae6 !important;
  box-shadow: -8px 0 28px rgba(0,0,0,.10);
  flex-direction: column;
  gap: 10px;
}

#conversation-view #notes-panel.notes-panel-open {
  display: flex !important;
}

#conversation-view #notes-panel .notes-heading {
  flex: 0 0 auto;
  margin: 0 !important;
}

#conversation-view #notes-panel .notes-heading strong {
  font-size: 16px !important;
}

#conversation-view #notes-panel .notes-heading > div > span {
  display: block !important;
  font-size: 11px !important;
}

#conversation-view #notes-panel .notes-list {
  display: flex !important;
  flex: 1 1 auto;
  min-height: 0 !important;
  max-height: none !important;
  overflow-y: auto !important;
  gap: 10px;
}

#conversation-view #notes-panel .note-card {
  flex: 0 0 auto;
}

#conversation-view #notes-panel .notes-form {
  display: flex !important;
  flex: 0 0 auto;
  margin-top: auto !important;
  align-items: flex-end !important;
}

#conversation-view #notes-panel .notes-form textarea {
  height: auto !important;
  min-height: 70px !important;
  max-height: 150px !important;
  font-size: 13px !important;
  resize: vertical;
}

#conversation-view #notes-panel .notes-form button {
  height: auto !important;
  min-height: 40px !important;
  font-size: 12px !important;
}

#conversation-view #notes-panel .notes-error {
  display: block !important;
  flex: 0 0 auto;
}

@media (max-width: 760px) {
  .notes-toggle {
    padding: 7px 8px;
    font-size: 11px;
  }

  #conversation-view #notes-panel {
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100% !important;
    padding: 14px !important;
    border-left: 0 !important;
    box-shadow: none;
  }
}

/* ===== END VD NOTES DRAWER V2 ===== */

