<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <title>Very Delivery CRM</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<main id="app">

  <section id="login-screen" class="login-card">
    <div class="brand">
      <div class="brand-mark">VD</div>
      <span>VERY DELIVERY</span>
    </div>
    <h1>Вход в CRM</h1>
    <p class="subtitle">Система управления переписками</p>
    <form id="login-form">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required>
      <label for="password">Пароль</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit">Войти</button>
      <p id="login-error" class="error"></p>
    </form>
  </section>

  <section id="dashboard" hidden>
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark">VD</div>
        <span>VERY DELIVERY CRM</span>
      </div>
      <span id="connection-status">● Подключение...</span>
      <button id="logout" class="secondary" type="button">Выйти</button>
    </header>

    <div class="dashboard-content">
      <h1>Переписки</h1>
      <p id="user-info"></p>

      <section id="admin-panel" hidden>
        <h2>Управление менеджерами</h2>
        <form id="manager-form">
          <label for="manager-name">Имя менеджера</label>
          <input id="manager-name" required>
          <label for="manager-email">Email менеджера</label>
          <input id="manager-email" type="email" required>
          <label for="manager-password">Пароль</label>
          <input id="manager-password" type="password" minlength="12" required>
          <button type="submit">Создать менеджера</button>
          <p id="manager-error" class="error"></p>
          <p id="manager-success" class="success"></p>
        </form>
        <div id="manager-list"></div>
      </section>

      <section id="manager-dashboard">
        <div class="messenger">

          <aside class="chat-sidebar">
            <div class="chat-sidebar-header">
              <h2>Все чаты</h2>
              <button id="refresh-chats" class="small-button" type="button">Обновить</button>
            </div>

            <input
              id="chat-search"
              type="search"
              placeholder="Поиск по клиентам и товарам..."
            >

            <div class="chat-filters">
              <button type="button" data-filter="all" class="active">Все</button>
              <button type="button" data-filter="free">Свободные</button>
              <button type="button" data-filter="mine">Мои</button>
            </div>

            <div class="chat-list-heading">
              <span>Переписки</span>
              <span id="chat-count">Загрузка...</span>
            </div>

            <div id="chat-list">
              <div class="empty">Загрузка чатов...</div>
            </div>
          </aside>

          <section class="conversation">

            <div id="chat-placeholder" class="chat-placeholder">
              <div>
                <div class="brand-mark">VD</div>
                <h2>Very Delivery</h2>
                <p>Выберите переписку, чтобы начать работу</p>
              </div>
            </div>

            <div id="conversation-view" hidden>
              <header class="conversation-header">
                <button id="back-to-list" class="small-button" type="button">
                  ← Назад
                </button>
                <div class="conversation-title">
                  <strong id="active-name">Клиент</strong>
                  <span id="active-item">Объявление</span>
                </div>
                <div id="assignment-control"></div>
              </header>

              <div id="message-list" class="message-list">
                <div class="empty">Загрузка сообщений...</div>
              </div>

              <p id="message-error" class="error"></p>

              <form id="message-form" class="message-form">
                <textarea
                  id="message-input"
                  rows="1"
                  placeholder="Напишите сообщение..."
                  required
                ></textarea>
                <button id="send-button" type="submit">Отправить</button>
              </form>
            </div>

          </section>
        </div>
      </section>
    </div>
  </section>
</main>

<script src="/app.js" defer></script>
</body>
</html>
