    margin-top: 2px;
  }
}


/* ===== INTERNAL NOTES VD ===== */

.notes-panel {
  flex: 0 0 auto;
  max-height: 245px;
  display: flex;
  flex-direction: column;
  border-top: 1px solid #eaeae6;
  background: #fff;
  padding: 12px 16px 8px;
  min-height: 0;
}

.notes-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.notes-heading > div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.notes-heading strong {
  font-size: 12px;
  color: #333;
}

.notes-heading span {
  font-size: 10px;
  color: #999;
}

.notes-count {
  display: grid;
  place-items: center;
  min-width: 23px;
  height: 23px;
  border-radius: 20px;
  background: #fff3c2;
  color: #725800 !important;
  font-weight: 800;
}

.notes-list {
  overflow-y: auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.note-card {
  background: #faf9f5;
  border: 1px solid #eeece4;
  border-radius: 9px;
  padding: 8px 11px;
}

.note-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.note-top strong {
  font-size: 11px;
  color: #333;
}

.note-top time {
  font-size: 10px;
  color: #999;
}

.note-text {
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.45;
  color: #444;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.note-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 5px;
}

.note-actions button {
  border: 0;
  padding: 2px 0;
  background: transparent;
  color: #777;
  font-size: 10px;
  cursor: pointer;
}

.note-actions button:hover {
  color: #222;
}

.note-actions button:last-child:hover {
  color: #c43d32;
}

.notes-empty {
  color: #999;
  text-align: center;
  font-size: 11px;
  padding: 10px;
}

.notes-form {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  margin-top: 8px;
}

.notes-form textarea {
  flex: 1;
  min-width: 0;
  min-height: 36px;
  max-height: 65px;
  resize: vertical;
  border: 1px solid #e8e6df;
  border-radius: 9px;
  padding: 8px 10px;
  font: inherit;
  font-size: 11px;
  line-height: 1.4;
}

.notes-form button {
  flex: none;
  border: 0;
  border-radius: 9px;
  background: #ffca05;
  color: #222;
  padding: 10px 13px;
  font-size: 11px;
  font-weight: 750;
  cursor: pointer;
}

.notes-form button:disabled {
  opacity: .5;
}

.notes-error {
  margin: 3px 0 0;
  color: #c43d32;
  font-size: 10px;
}

@media(max-width:760px) {
  .notes-panel {
    max-height: 225px;
    padding: 9px 10px 6px;
  }

  .notes-form textarea {
    min-height: 36px;
    max-height: 55px;
  }

  .notes-form button {
    padding: 10px;
  }
}

/* ===== END INTERNAL NOTES VD ===== */


/* ===== NOTES TOP POSITION ===== */

.notes-panel {
  order: 0;
  flex: 0 0 auto;
  max-height: 175px;
  padding: 9px 16px;
  border-top: 0;
  border-bottom: 1px solid #eaeae6;
  overflow: hidden;
}

.notes-heading {
  margin-bottom: 6px;
}

.notes-list {
  max-height: 78px;
  overflow-y: auto;
}

.notes-form {
  margin-top: 6px;
}

.notes-form textarea {
  min-height: 34px;
  max-height: 42px;
}

@media(max-width:760px) {
  .notes-panel {
    max-height: 155px;
    padding: 7px 10px;
  }

  .notes-list {
    max-height: 58px;
  }
}

/* ===== END NOTES TOP POSITION ===== */



/* ===== VD: МЕНЮ ДЕЙСТВИЙ С СООБЩЕНИЯМИ ===== */

.message-row .bubble {
  overflow: visible !important;
}

.message-menu {
  position: absolute;
  z-index: 20;
  top: 2px;
  right: -31px;
}

.message-row.outgoing .message-menu {
  right: auto;
  left: -31px;
}

.message-menu-toggle {
  width: 25px;
  height: 27px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e7e7e2;
  border-radius: 8px;
  background: #fff;
  color: #666;
  font-size: 19px;
  line-height: 1;
  cursor: pointer;
  opacity: 0;
  transition: opacity .15s ease, background .15s ease;
}

.message-row:hover .message-menu-toggle,
.message-menu-toggle:focus,
.message-menu-toggle:focus-visible {
  opacity: 1;
}

.message-menu-toggle:hover {
  background: #f4f4f0;
}

.message-menu-popup {
  position: absolute;
  top: 30px;
  right: 0;
  min-width: 145px;
  padding: 5px;
  border: 1px solid #e9e9e5;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 7px 24px rgba(0,0,0,.13);
  z-index: 30;
}

.message-row.outgoing .message-menu-popup {
  right: auto;
  left: 0;
}

.message-menu-popup[hidden] {
  display: none !important;
}

.message-menu-popup button {
  display: block;
  width: 100%;
  padding: 9px 11px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #262626;
  text-align: left;
  font-size: 12px;
  cursor: pointer;
}

.message-menu-popup button:hover {
  background: #f5f5f1;
}

.message-menu-popup .message-delete-action {
  color: #c0392b;
}

.message-menu-popup button:disabled {
  opacity: .5;
  cursor: wait;
}

@media (max-width: 760px) {
  .message-menu-toggle {
    opacity: .75;
    width: 27px;
    height: 29px;
  }

  .message-menu {
    right: -30px;
  }

  .message-row.outgoing .message-menu {
    left: -30px;
  }
}
